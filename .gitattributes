# Normalización de fines de línea para todo el repo.
# Evita que los ficheros aparezcan como "modificados" al editarlos
# desde Windows (CRLF) en un repo guardado con LF.

# Por defecto: detecta texto y guarda en LF
* text=auto eol=lf

# Forzar LF explícitamente para los tipos de texto del proyecto
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.po    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf

# Ficheros que deben mantener CRLF (scripts de Windows)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Ficheros binarios: que git no los toque
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.sqlite3 binary
*.zip   binary
*.gz    binary
