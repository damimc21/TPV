# =====================================================
# .gitignore - Proyecto TPV
# =====================================================

# --- Entornos virtuales ---
venv/
.venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Django ---
db.sqlite3
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
/staticfiles/
/media/
*.mo
!locale/**/LC_MESSAGES/*.mo

# --- Configuracion sensible ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets.json
secrets.yaml
secrets.yml

scripts/update-credentials.ps1
scripts/deploy.ps1

# --- Logs ---
*.log
logs/

# --- IDEs y editores ---
.vscode/
.idea/
*.swp
*.swo
*.bak
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Build / distribucion ---
build/
dist/

# --- Tests / cobertura ---
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Frontend (por si en el futuro hay tooling JS) ---
node_modules/
.cache/
.parcel-cache/

# --- Terraform / infra ---
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
*.tfvars.json
!example.tfvars

# --- Base de datos / scripts de prototipo ---
tpv.sql

# --- Backups locales y artefactos temporales ---
backups/
_backup_limpieza_*/
output.txt
tmp_*
tmp*/
.claude/
test_claude_write.txt
preview_icons.html
reset_venv.ps1

# --- Terraform ---
infra/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfvars
*.tfstate
*.tfstate.backup

# --- Kubernetes ---
k8s/secrets.yaml