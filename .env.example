# ============================================================
# Plantilla de variables de entorno para desarrollo local.
# Copia este fichero a .env y rellena los valores. NO subas el .env.
# ============================================================

# --- Django ---

# Clave secreta usada para firmar sesiones, cookies, tokens, etc.
# Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True solo en desarrollo. En produccion debe ser False.
DJANGO_DEBUG=True

# Dominios permitidos, separados por coma.
# Ejemplo dev: 127.0.0.1,localhost
# Ejemplo prod: tpv.miempresa.com,www.tpv.miempresa.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origenes desde los que se aceptan POST/PUT/DELETE (deben ir con esquema).
# Ejemplo: https://tpv.miempresa.com,https://www.tpv.miempresa.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos ---

# Si lo dejas vacio, Django usa db.sqlite3 en la raiz del proyecto.
# Formatos soportados (definidos en _database_from_url de settings.py):
#   sqlite:///ruta/relativa/o/absoluta.sqlite3
#   mysql://USER:PASSWORD@HOST:3306/DBNAME
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
